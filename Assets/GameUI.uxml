        <ui:VisualElement name="WinPanel" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Tutorial_Demo/Demo_Art/Common/WinScreen.png?fileID=2800000&amp;guid=d46766d63d5ca44c6b1a4d318b1eaf72&amp;type=3#WinScreen&quot;); top: 0; left: 0; bottom: 0; right: 0; width: 800px; height: 400px; -unity-background-scale-mode: scale-to-fit;"/>
