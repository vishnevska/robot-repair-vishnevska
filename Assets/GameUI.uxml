    <ui:VisualElement name="NonPlayerDialogue" style="flex-grow: 1; position: absolute; bottom: 5%; left: auto; right: 20%; height: 150px; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/UICounterBar.png?fileID=2800000&amp;guid=4bb9e5210d4bc484ab335c62e1e0ffd3&amp;type=3#UICounterBar&quot;);">
        <ui:Label text="Привіт, мандрівнику! Допоможи мені полагодити роботів!" style="width: 100%; height: 100%; padding-top: 20px; padding-right: 20px; padding-bottom: 20px; padding-left: 20px; font-size: 23px; white-space: pre-wrap; color: rgb(16, 1, 1);"/>
