            <ui:VisualElement name="HealthBar" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/Ducko/UI/UIHealthBar.png?fileID=2800000&amp;guid=39fe000f2b6d9d04b93d6a76310e29aa&amp;type=3#UIHealthBar&quot;); -unity-background-scale-mode: scale-to-fit; justify-content: space-around; width: 100%; right: auto; height: 100%; left: auto; top: auto; flex-direction: column; background-size: 100% 100%; align-self: flex-start; align-items: flex-start;"/>
        </ui:VisualElement>
